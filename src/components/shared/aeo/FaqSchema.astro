---
interface FAQ {
	question: string;
	answer: string;
}

interface Props {
	faqs: FAQ[];
	url: string | URL;
}

const { faqs, url } = Astro.props;

const schema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"@id": `${url}#faq`,
	mainEntity: faqs.map((faq) => ({
		"@type": "Question",
		name: faq.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: faq.answer,
		},
	})),
	about: { "@id": `${url}#app` },
};
---

<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(schema)}
/>
