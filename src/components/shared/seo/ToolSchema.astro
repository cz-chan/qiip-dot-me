---
// https://schema.org/WebApplication
import { SITE_INFO } from "@/global/site-info.ts";

interface Props {
	name: string;
	description: string;
	url: string;
}

const { name, description, url } = Astro.props;

const toolUrl = new URL(url, SITE_INFO.url).href;

const schema = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	"@id": `${toolUrl}#app`,
	name,
	description,
	url: toolUrl,
	applicationCategory: "UtilitiesApplication",
	operatingSystem: "Web",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "EUR",
	},
	isPartOf: { "@id": new URL("/#app", SITE_INFO.url).href },
	creator: { "@id": "https://c12z.io/#person" },
};
---

<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(schema)}
/>
