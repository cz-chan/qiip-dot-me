---
import { SITE_INFO } from "@/global/site-info.ts";

interface Props {
	pageTitle: string;
	pageDescription: string;
	ogImage?: string;
	ogImageAlt?: string;
	ogType?: "website" | "article";
}

const {
	pageTitle,
	pageDescription,
	ogImage,
	ogImageAlt,
	ogType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const ogImageUrl = ogImage
	? new URL(ogImage, Astro.site)
	: new URL("./og-image.webp", Astro.site);
const ogImageUrlAlt = ogImageAlt || pageTitle;
---

<title>{pageTitle}</title>
<meta
	content={pageTitle}
	name="title"
/>
<meta
	name="description"
	content={pageDescription}
/>
<meta
	content={SITE_INFO.author}
	name="author"
/>

<link
	rel="canonical"
	href={canonicalURL}
/>

{/* Open Graph / Facebook / WhatsApp */}
<meta
	property="og:title"
	content={pageTitle}
/>
<meta
	property="og:url"
	content={canonicalURL}
/>
<meta
	property="og:description"
	content={pageDescription}
/>
<meta
	content={SITE_INFO.title}
	property="og:site_name"
/>
<meta
	content={SITE_INFO.location}
	property="og:locale"
/>
<meta
	property="og:image"
	content={ogImageUrl}
/>
<meta
	property="og:image:alt"
	content={ogImageUrlAlt}
/>
<meta
	property="og:image:width"
	content="1200"
/>
<meta
	property="og:image:height"
	content="630"
/>
<meta
	property="og:locale"
	content={SITE_INFO.location}
/>

<meta
	property="fb:app_id"
	content="1380313990616340"
/>

{/* SOLO PARA EL MAIN: NO HAY TAGS*/}
<meta
	property="og:type"
	content={ogType}
/>

{/* Twitter */}
<meta
	name="twitter:title"
	content={pageTitle}
/>
<meta
	name="twitter:description"
	content={pageDescription}
/>
<meta
	name="twitter:image"
	content={ogImageUrl}
/>
<meta
	name="twitter:image:alt"
	content={ogImageUrlAlt}
/>
<meta
	name="twitter:card"
	content="summary_large_image"
/>
<meta
	name="twitter:site"
	content="@cz__chan"
/>
<meta
	name="twitter:creator"
	content="@cz__chan"
/>
