---
import { SITE_INFO, type TOOLS_INFO_TYPES } from "@/global/site-info.ts";
import { getTool } from "@/components/layout/home/tools/tools.ts";

import PagesSEO from "@/seo/PagesSEO.astro";
import FaqSchema from "@/aeo/FaqSchema.astro";
import ToolSchema from "@/seo/ToolSchema.astro";
import HowToSchema from "@/aeo/HowToSchema.astro";

interface Props {
	tool: TOOLS_INFO_TYPES;
	onAir: boolean;
}

const { tool, onAir } = Astro.props;
const { pathname } = Astro.url;

const url = new URL(pathname, SITE_INFO.url).href;

const currentTool = getTool(pathname);
if (!currentTool) throw new Error(`Tool not found in tools.ts: ${pathname}`);
---

<PagesSEO
	pageTitle={tool.title}
	pageDescription={tool.description}
	ogType="article"
	ogImage={tool.ogImage}
	ogImageAlt={tool.ogImageAlt}
/>
{
	onAir && (
		<>
			<ToolSchema
				name={tool.label}
				description={tool.description}
				url={url}
			/>
			{tool.faqs && (
				<FaqSchema
					url={url}
					faqs={tool.faqs}
				/>
			)}
			{tool.howTo && tool.howToTitle && (
				<HowToSchema
					url={url}
					name={tool.howToTitle}
					description={tool.description}
					steps={tool.howTo}
				/>
			)}
		</>
	)
}
